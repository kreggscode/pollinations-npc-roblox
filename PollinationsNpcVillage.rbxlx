    <Item class="Script" referent="1">
      <Properties>
        <string name="Name">ExampleVillage</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")

local PollinationsNpc = require(game.ServerScriptService.PollinationsNpc)

local GATE_OPEN_HEIGHT = 6
local TALK_RANGE = 40

local function attachBubble(npcModel, displayName)
	local body = npcModel:FindFirstChild("Body")
	if not body then
		return nil
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "SpeechBubble"
	billboard.Size = UDim2.fromScale(8, 2.2)
	billboard.StudsOffset = Vector3.new(0, 5.5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 48
	billboard.Enabled = false

	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.Size = UDim2.fromScale(1, 0.3)
	name.BackgroundTransparency = 1
	name.Text = displayName
	name.TextColor3 = Color3.fromRGB(255, 220, 140)
	name.TextStrokeTransparency = 0.2
	name.TextScaled = true
	name.Parent = billboard

	local dialogue = Instance.new("TextLabel")
	dialogue.Name = "Label"
	dialogue.Size = UDim2.fromScale(1, 0.65)
	dialogue.Position = UDim2.fromScale(0, 0.35)
	dialogue.BackgroundTransparency = 1
	dialogue.TextColor3 = Color3.new(1, 1, 1)
	dialogue.TextStrokeTransparency = 0.2
	dialogue.TextScaled = true
	dialogue.TextWrapped = true
	dialogue.Parent = billboard

	billboard.Parent = body
	return billboard
end

local function showBubble(bubble, dialogue)
	if not bubble or type(dialogue) ~= "string" or dialogue == "" then
		return
	end
	bubble.Label.Text = dialogue
	bubble.Enabled = true
	task.delay(8, function()
		bubble.Enabled = false
	end)
end

local function position(npcModel)
	local body = npcModel:FindFirstChild("Body")
	return body and body.Position or Vector3.zero
end

local function playerDistance(player, target)
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return math.huge
	end
	return (root.Position - target).Magnitude
end

local gate = Workspace:FindFirstChild("Gate")

local mara = PollinationsNpc.start({
	name = "Gatekeeper Mara",
	persona = "You are Gatekeeper Mara of a small village. You are polite but wary of strangers. "
		.. "You speak in one short sentence at a time. You guard the north gate.",
	actions = {
		-- The model only ever *proposes* this type. Deciding is ours: the gate
		-- opens when it is shut and the player is close enough to matter.
		open_gate = function(_action, context)
			if not gate or gate.Position.Y > GATE_OPEN_HEIGHT then
				return false
			end
			if playerDistance(context.player, gate.Position) > TALK_RANGE then
				return false
			end
			gate.Position = gate.Position + Vector3.new(0, 14, 0)
			return true
		end,
	},
})

local borin = PollinationsNpc.start({
	name = "Borin",
	persona = "You are Borin, the tavern keeper. You are grumpy but you like most people. "
		.. "You mention your stew often. You speak in one short sentence at a time.",
})

local characters = {
	{ npc = mara, model = Workspace:WaitForChild("Mara") },
	{ npc = borin, model = Workspace:WaitForChild("Borin") },
}

for _, entry in ipairs(characters) do
	entry.bubble = attachBubble(entry.model, entry.npc.name)
	local body = entry.model:FindFirstChild("Body")
	local prompt = body and body:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Triggered:Connect(function(player)
			local reply = entry.npc.ask(player, "Hello. Who are you?")
			if reply then
				showBubble(entry.bubble, reply.dialogue)
			end
		end)
	end
end

local function nearestCharacter(player)
	local best, bestDistance
	for _, entry in ipairs(characters) do
		local distance = playerDistance(player, position(entry.model))
		if distance <= TALK_RANGE and (not bestDistance or distance < bestDistance) then
			best, bestDistance = entry, distance
		end
	end
	return best
end

local function handle(player, text)
	local lower = string.lower(text)
	local chosen
	for _, entry in ipairs(characters) do
		if string.find(lower, string.lower(entry.npc.name), 1, true) then
			chosen = entry
			break
		end
	end
	if not chosen then
		chosen = nearestCharacter(player)
	end
	if not chosen then
		return
	end

	local reply = chosen.npc.ask(player, text)
	if reply then
		showBubble(chosen.bubble, reply.dialogue)
	end
end

TextChatService.OnIncomingMessage = function(textChatMessage)
	local source = textChatMessage.TextSource
	if source then
		local player = Players:GetPlayerByUserId(source.UserId)
		if player then
			task.spawn(handle, player, textChatMessage.Text)
		end
	end
	return Instance.new("TextChatMessageProperties")
end

if not mara.hasApiKey() then
	warn(
		"[PollinationsNpc] No API key found. Add the POLLINATIONS_API_KEY secret "
			.. "in Game Settings > Security, or set the PollinationsApiKey attribute "
			.. "on Workspace for a local test."
	)
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">PollinationsNpc</string>
        <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Actions = require(script.Actions)
local Config = require(script.Config)
local Http = require(script.Http)
local Prompt = require(script.Prompt)

local PollinationsNpc = {}

local function readApiKey()
	local ok, secret = pcall(function()
		return HttpService:GetSecret(Config.SECRET_NAME)
	end)
	if ok and type(secret) == "string" and secret ~= "" then
		return secret
	end

	-- Studio-only fallback so the example place runs before a secret exists.
	local attribute = Workspace:GetAttribute(Config.API_KEY_ATTRIBUTE)
	if type(attribute) == "string" and attribute ~= "" then
		return attribute
	end

	return nil
end

-- Gives one character a conversation. Returns an object with :ask(player, message).
--
-- options.actions maps an action type to a handler(action) that returns true
-- only when it really performed the action. The model can propose a type from
-- that table; the handler decides.
function PollinationsNpc.start(options)
	local npc = {
		name = options.name or "NPC",
		persona = options.persona or "You are a friendly villager.",
		model = options.model or Config.DEFAULT_MODEL,
		maxHistoryTurns = options.maxHistoryTurns or Config.DEFAULT_HISTORY_TURNS,
		cooldownSeconds = options.cooldownSeconds or Config.DEFAULT_COOLDOWN,
		actions = options.actions or {},
		onReply = options.onReply,
	}

	local apiKey = readApiKey()
	local history = {}
	local lastAsked = {}
	local actionTypes = Actions.types(npc.actions)

	local function turnsFor(player)
		local turns = history[player.UserId]
		if not turns then
			turns = {}
			history[player.UserId] = turns
		end
		return turns
	end

	function npc.hasApiKey()
		return apiKey ~= nil
	end

	-- Returns { dialogue, action, actionPerformed }, or nil when the request
	-- was skipped (cooldown, no key) or the API failed.
	function npc.ask(player, message)
		if apiKey == nil or type(message) ~= "string" or message == "" then
			return nil
		end

		local now = os.clock()
		if lastAsked[player.UserId] and now - lastAsked[player.UserId] < npc.cooldownSeconds then
			return nil
		end
		lastAsked[player.UserId] = now

		local turns = turnsFor(player)
		local messages = Prompt.buildMessages(npc.persona, actionTypes, turns, message)
		local ok, result = Http.chat(npc.model, apiKey, messages)
		if not ok then
			return nil
		end

		local reply = Prompt.parseReply(result.reply)
		local performed = Actions.dispatch(npc.actions, reply.action, {
			player = player,
			npcName = npc.name,
		})

		table.insert(turns, { player = message, npc = reply.dialogue })
		while #turns > npc.maxHistoryTurns * 2 do
			table.remove(turns, 1)
		end

		if npc.onReply then
			npc.onReply(player, reply, performed)
		end

		return {
			dialogue = reply.dialogue,
			action = reply.action,
			actionPerformed = performed,
		}
	end

	Players.PlayerRemoving:Connect(function(player)
		history[player.UserId] = nil
		lastAsked[player.UserId] = nil
	end)

	return npc
end

return PollinationsNpc
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Actions</string>
          <string name="Source"><![CDATA[local Actions = {}

-- Runs the handler the game registered for action.type. The handler owns the
-- policy: it returns true only if it actually performed the action, and it is
-- free to refuse anything the model proposed. Returns whether an action ran.
function Actions.dispatch(registry, action, context)
	if type(action) ~= "table" or type(action.type) ~= "string" then
		return false
	end

	local handler = registry[action.type]
	if type(handler) ~= "function" then
		return false
	end

	local ok, performed = pcall(handler, action, context or {})
	return ok and performed == true
end

function Actions.types(registry)
	local names = {}
	for name in pairs(registry) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[local Config = {}

Config.BASE_URL = "https://gen.pollinations.ai"
Config.SECRET_NAME = "POLLINATIONS_API_KEY"
Config.API_KEY_ATTRIBUTE = "PollinationsApiKey"
Config.DEFAULT_MODEL = "nova-fast"
Config.DEFAULT_MAX_TOKENS = 120
Config.DEFAULT_TEMPERATURE = 0.8
Config.DEFAULT_HISTORY_TURNS = 8
Config.DEFAULT_COOLDOWN = 3
Config.MAX_ATTEMPTS = 3

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Http</string>
          <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")

local Config = require(script.Parent.Config)

local Http = {}

local function retryable(status)
	return status == 429 or status >= 500
end

-- One chat turn against the Pollinations API. Returns
-- (true, { reply = string }) or (false, { error = string }).
function Http.chat(model, apiKey, messages)
	local body = HttpService:JSONEncode({
		model = model,
		messages = messages,
		max_tokens = Config.DEFAULT_MAX_TOKENS,
		temperature = Config.DEFAULT_TEMPERATURE,
	})

	local lastError = "unknown"

	for attempt = 1, Config.MAX_ATTEMPTS do
		local ok, response = pcall(function()
			return HttpService:RequestAsync({
				Url = Config.BASE_URL .. "/v1/chat/completions",
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["Authorization"] = "Bearer " .. apiKey,
				},
				Body = body,
			})
		end)

		if not ok then
			lastError = tostring(response)
			task.wait(attempt)
		elseif response.Success then
			local decoded = HttpService:JSONDecode(response.Body)
			local choice = decoded.choices and decoded.choices[1]
			local content = choice and choice.message and choice.message.content
			if type(content) == "string" and content ~= "" then
				return true, { reply = content }
			end
			lastError = "empty_completion"
		else
			lastError = "http_" .. tostring(response.StatusCode)
			if not retryable(response.StatusCode) then
				return false, { error = lastError }
			end
		end
	end

	return false, { error = lastError }
end

return Http
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Prompt</string>
          <string name="Source"><![CDATA[local Prompt = {}

local function defaultDecode(raw)
	return game:GetService("HttpService"):JSONDecode(raw)
end

-- The model is only asked to propose an action from a whitelist the game
-- supplied, and it is told the game may refuse. It never decides what
-- happens: Actions.dispatch runs the handler the game registered.
function Prompt.systemPrompt(persona, actionTypes)
	local prompt = persona
		.. "\n\nReply with a single JSON object and nothing else, no code fences: "
		.. '{"dialogue": string, "action": null | {"type": string, "value": string}}. '
		.. '"dialogue" is what the character says out loud, one short in-character sentence.'

	if #actionTypes > 0 then
		prompt = prompt
			.. " You may propose one of these action types only when the player clearly asks for it: "
			.. table.concat(actionTypes, ", ")
			.. ". Otherwise set action to null. Proposing an action does not make it happen; the game decides."
	else
		prompt = prompt .. " Always set action to null."
	end

	return prompt
end

function Prompt.buildMessages(persona, actionTypes, turns, message)
	local messages = {
		{ role = "system", content = Prompt.systemPrompt(persona, actionTypes) },
	}
	for _, turn in ipairs(turns) do
		table.insert(messages, { role = "user", content = turn.player })
		table.insert(messages, { role = "assistant", content = turn.npc })
	end
	table.insert(messages, { role = "user", content = message })
	return messages
end

-- Models wrap JSON in prose or code fences. Pull out the first object and
-- decode it; anything that does not decode is treated as plain dialogue so a
-- malformed reply still reaches the player. `decode` exists so the parsing
-- can be exercised outside Roblox.
function Prompt.parseReply(reply, decode)
	decode = decode or defaultDecode

	local text = string.gsub(reply, "^%s*```[%w%-]*%s*", "")
	text = string.gsub(text, "%s*```%s*$", "")

	local first = string.find(text, "{")
	local last = string.find(text, "}")
	if first and last and last > first then
		local ok, decoded = pcall(decode, string.sub(text, first, last))
		if ok and type(decoded) == "table" and type(decoded.dialogue) == "string" then
			local action = nil
			if type(decoded.action) == "table" and type(decoded.action.type) == "string" then
				action = decoded.action
			end
			return { dialogue = decoded.dialogue, action = action }
		end
	end

	return { dialogue = text, action = nil }
end

return Prompt
]]></string>
        </Properties>
      </Item>
